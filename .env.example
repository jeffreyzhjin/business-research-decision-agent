# Choose exactly one model backend: groq, bailian or deepseek
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash

# DeepSeek official API: use your own private key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional alternative backends:
GROQ_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Web retrieval still uses Tavily; configure separately
TAVILY_API_KEY=
