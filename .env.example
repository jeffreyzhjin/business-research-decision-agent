# Select: groq or bailian. Groq remains default for compatibility.
LLM_PROVIDER=groq
# Optional model override (Groq: openai/gpt-oss-20b; Bailian: qwen-plus)
LLM_MODEL=
GROQ_API_KEY=your_groq_api_key_here

# For Mainland China, set LLM_PROVIDER=bailian and configure:
DASHSCOPE_API_KEY=
# China mainland (Beijing) endpoint; change only for other supported regions
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Search is still Tavily in this development iteration.
TAVILY_API_KEY=your_tavily_api_key_here
